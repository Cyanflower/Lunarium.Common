<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- 向消费者交付 XML 文档(IntelliSense); 缺失的公开注释会以 CS1591 提醒, 需保持为 0 告警 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ===== SourceLink / 符号包 ===== -->
  <PropertyGroup>
    <!-- 让调试器能从 PDB 跳转到 GitHub 上对应 commit 的源码(本仓库为公开仓库, 无需额外凭据) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- 确定性构建(源码路径规范化为 /_/)只在 CI 开启: 本地开启会破坏本地调试体验 -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- PDB 走符号服务器而非打进 .nupkg -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- ===== NuGet Info ===== -->
  <PropertyGroup>
    <Version>1.2.1</Version>
    <Authors>Cyanflower</Authors>
    <Description>A zero-dependency .NET common library: character-set constants, NanoID and lock-free snowflake ID generation, dirty/CTS-based debouncers, and debounced JSON file-backed key-value and single-document stores. Native AOT compatible.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Cyanflower/Lunarium.Common</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cyanflower/Lunarium.Common.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Lunarium.Common</PackageId>
    <PackageTags>lunarium;utilities;alphabet;nanoid;snowflake;id-generator;debounce;cache;aot;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Cyanflower 2026</Copyright>
  </PropertyGroup>

  <!-- README 位于仓库根，故用相对路径打包到包根 -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- 仅对测试程序集开放 internal 类型(JsonFileHandler / SafeOnError / CacheJsonContext 等) -->
  <ItemGroup>
    <InternalsVisibleTo Include="Lunarium.Common.Tests" />
  </ItemGroup>

</Project>
